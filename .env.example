# ============================================================
# novel-rag 环境配置示例
# 复制为 .env 后填写真实值：cp .env.example .env
# ============================================================

# ── Embedding API（默认 SiliconFlow，OpenAI 兼容）────────────
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
# 向量维度（bge-m3 = 1024；换模型后必须同步修改，否则写入报错）
EMBEDDING_DIM=1024

# ── LLM 生成 / 重排（可选，不配置则回落 SILICONFLOW_API_KEY）──
# 想用其他 OpenAI 兼容服务时取消注释并填写：
# LLM_API_KEY=your-llm-api-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# RERANK_MODEL=deepseek-ai/DeepSeek-V3

# ── 路径（一般不用改）──────────────────────────────────────
# BIBLE_DIR=_bible
# OUTLINE_DIR=_outline
# CHAPTERS_DIR=chapters
# CHROMA_PERSIST_DIR=chroma_db

# ── 当前活跃书（分书命名空间，写作管线用）──────────────────
# CURRENT_BOOK=duanze
