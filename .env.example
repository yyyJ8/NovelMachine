# ============================================================
# novel-rag 环境配置示例
# 复制为 .env 后填写真实值：cp .env.example .env
# ============================================================

# ── Embedding API（默认 SiliconFlow，OpenAI 兼容）────────────
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
# 向量维度（bge-m3 = 1024；换模型后必须同步修改，否则写入报错）
EMBEDDING_DIM=1024

# ── Embedding 速率控制（429 限流时调整）──────────────────
# 每批条数（默认 32；限流时调小到 8~16 降低单批 token 量）
# EMBEDDING_BATCH_SIZE=32
# 批间等待秒数（默认 0；限流时调大到 1~3 降速）
# EMBEDDING_BATCH_DELAY=0
# 429 限流专用重试次数（默认 10，等 TPM 窗口恢复后自动继续）
# RATE_LIMIT_MAX_RETRIES=10
# 429 限流单次最大等待秒数（默认 60）
# RATE_LIMIT_MAX_WAIT=60

# ── 分块与通用重试（可选，默认值已可用）──────────────────
# 分块大小（默认 512 字）
# CHUNK_SIZE=512
# 分块重叠（默认 64 字）
# CHUNK_OVERLAP=64
# 通用网络错误重试次数（默认 3；429 用上面的 RATE_LIMIT_* 单独控制）
# MAX_RETRIES=3
# 通用重试等待秒数（默认 1.0）
# RETRY_DELAY=1.0

# ── LLM 生成 / 重排（可选，不配置则回落 SILICONFLOW_API_KEY）──
# 想用其他 OpenAI 兼容服务时取消注释并填写：
# LLM_API_KEY=your-llm-api-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# RERANK_MODEL=deepseek-ai/DeepSeek-V3

# ── 路径（一般不用改；绝对路径 / 相对仓库根 都支持）────────
# 题材素材（RAG 输入，跨书共享）：把你自己的资料放进去
# BIBLE_DIR=_bible
# 索引产物（可重建）
# CHROMA_PERSIST_DIR=chroma_db
# BM25_INDEX_DIR=bm25_indexes

# ── 当前活跃书：一本书 = 一个自包含目录 ────────────────────
# BOOK_DIR 指到书目录的根（可以放在仓库外的任何位置）。
# 不配置时回落到 <仓库>/novels/<CURRENT_BOOK>/
# CURRENT_BOOK=mybook
# BOOK_DIR=D:/novels/mybook
